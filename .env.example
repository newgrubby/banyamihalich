# ─────────────────────────────────────────────────────────────────────────────
# Переменные окружения сайта «У Михалыча».
# Секретов в проекте нет: все переменные необязательные и публичные.
# Скопируйте файл в .env (или задайте значения в панели Timeweb) при необходимости.
# ─────────────────────────────────────────────────────────────────────────────

# Канонический адрес сайта: используется в canonical, Open Graph,
# JSON-LD, robots.txt и sitemap.xml.
# Если не задана — берётся значение по умолчанию https://banya-mihalycha.ru
# Задавайте с протоколом и без слэша на конце.
NEXT_PUBLIC_SITE_URL=https://banya-mihalycha.ru

# Порт HTTP-сервера в production (`npm run start`).
# Обычно подставляется хостингом автоматически; по умолчанию 3000.
PORT=3000

# Окружение Node.js. Timeweb выставляет сам, вручную задавать не нужно.
# NODE_ENV=production
